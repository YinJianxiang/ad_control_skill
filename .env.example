# API 认证：优先使用显式认证；没有时才尝试账号登录
AD_CONTROL_BASE_URL=http://your-host
AD_CONTROL_API_URL=http://your-host/market-admin/adminNew/api/3221
AD_CONTROL_METADATA_URL=/market-admin/adminNew/api/3231
AD_CONTROL_CONDITION_TREE_URL=/market-admin/adminNew/api/3232
AD_CONTROL_RULE_LIST_URL=
AD_CONTROL_RULE_LIST_METHOD=GET
AD_CONTROL_AUTHORIZATION=
AD_CONTROL_SHIRO_COOKIE=
AD_CONTROL_BL_UID=
AD_CONTROL_LOGIN_URL=http://your-host/market-admin/login
AD_CONTROL_LOGIN_USER=
AD_CONTROL_LOGIN_PASSWORD=
AD_CONTROL_LOGIN_PHOTO=
AD_CONTROL_LOGIN_CODE=
AD_CONTROL_AUTH_CACHE=.artifacts/state/ad_control_auth.json
AD_CONTROL_AUTH_CACHE_TTL_S=3600

# Job
AD_CONTROL_JOB_TRIGGER_URL_TEMPLATE=http://your-job-host/path?ruleId={{rule_id}}

# Generic case files omit validation values and use these global defaults.
# An explicit validation value in a case JSON is a deliberate per-case override.
AD_CONTROL_HIT_TIMEOUT_S=120
AD_CONTROL_MISS_OBSERVE_S=120
AD_CONTROL_POLL_INTERVAL_S=3

# 测试数据库：写入/删除前必须设置为 test
AD_CONTROL_DB_ENV=
AD_CONTROL_DB_HOST=
AD_CONTROL_DB_PORT=3306
AD_CONTROL_DB_NAME=
AD_CONTROL_DB_USER=
AD_CONTROL_DB_PASSWORD=

# 运行产物只能放在该目录下
AD_CONTROL_ARTIFACT_ROOT=.artifacts

# Allure：默认单文件 + 本地 HTTP，控制台打印 REPORT_URL=http://127.0.0.1:<port>/index.html
# AD_CONTROL_ALLURE_CLI=1
# AD_CONTROL_ALLURE_SINGLE_FILE=1
# AD_CONTROL_ALLURE_SERVE=1
# AD_CONTROL_ALLURE_OPEN_BROWSER=1
# AD_CONTROL_ALLURE_DETACH=1
# AD_CONTROL_ALLURE_HOST=127.0.0.1
# AD_CONTROL_ALLURE_PORT=0

# Test execution performance
# Independent cases can overlap API/DB waits; set to 1 for serial debugging.
AD_CONTROL_WORKERS=4
# Full Allure HTML is generated once per run; set to 0 for fast local runs.
AD_CONTROL_ALLURE_CLI=1
